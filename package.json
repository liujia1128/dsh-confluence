{
  "name": "dsh-plugin-confluence",
  "version": "1.0.0",
  "description": "Confluence pages, comments, attachments, and properties as typed DeepSeek Harness tools, with a settings page for the connection and write policy.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "SKILL.md",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README_ZH.md",
    "readme_zh.txt",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "confluence-cli": "^2.31.2"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "scripts": {
    "test": "jest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "confluence",
    "atlassian",
    "wiki",
    "atlassian-confluence"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujia1128/dsh-confluence.git"
  },
  "homepage": "https://github.com/liujia1128/dsh-confluence#readme",
  "bugs": {
    "url": "https://github.com/liujia1128/dsh-confluence/issues"
  }
}
